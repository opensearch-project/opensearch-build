###############################################################
# Mend (WhiteSource) Unified-Agent format configuration file
#
# Consumed by the Mend GitHub App because `.whitesource` sets
# "configMode": "LOCAL". The App supplies its own credentials and
# project/product mapping, so no apiKey/projectName/wss.url here.
#
# NOTE: This file is NOT used by the nightly whitesource-scan
# Jenkins job. That job runs the Unified Agent CLI explicitly
# against tools/vulnerability-scan/wss-unified-agent.config.
###############################################################

########################################
# Package Manager Dependency resolvers #
########################################
# Disable every resolver by default, then opt in below.
resolveAllDependencies=false

# Python is the only shipped dependency tree in this repo (Pipfile).
python.resolveDependencies=true
python.runPipenvPreStep=true
python.installVirtualenv=true
python.ignoreSourceFiles=true

# Gradle here exists only to run the Jenkins shared-library tests in
# tests/jenkins via `./gradlew test`. The com.mkobit.jenkins.pipelines
# plugin injects the entire Jenkins runtime (jenkins-core, bouncycastle,
# jackson, spring, mina, ...) into the main compile/runtime classpaths as
# well as the test ones, and none of it is published or distributed --
# `jar` output is never uploaded. Resolving it only files CVE issues for
# a test harness, so keep it off.
gradle.resolveDependencies=false

#############################################
# File system scan source files & binaries #
#############################################
# Only package-manager resolution is needed. Leaving this on would
# re-detect the same Jenkins jars out of the local Gradle cache and
# reintroduce the noise this config exists to prevent.
fileSystemScan=false
