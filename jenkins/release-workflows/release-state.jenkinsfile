// @job-name: distribution-release-state
// @description: Indexes per-criterion release readiness (entrance and exit criteria) for every active release into the opensearch_release_state metrics index, and records a release manager's Go/No-Go decision for one version when DECISION is set. A decision is indexed with a snapshot of the criteria it was taken against and commented on the release issue.

lib = library(identifier: 'jenkins@13.9.0', retriever: modernSCM([
    $class: 'GitSCMSource',
    remote: 'https://github.com/opensearch-project/opensearch-build-libraries.git',
]))

pipeline {
    options {
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(daysToKeepStr: '30'))
    }
    agent {
        docker {
            label 'Jenkins-Agent-AL2023-X64-M54xlarge-Docker-Host'
            image 'opensearchstaging/ci-runner:ci-runner-almalinux8-opensearch-build-v1'
            registryUrl 'https://public.ecr.aws/'
            alwaysPull true
        }
    }
    triggers {
        parameterizedCron '''
            H * * * * %VERSION=3.9.0;CRITERIA=all
            H 1 * * * %CRITERIA=all
        '''
    }
    parameters {
        string(
            name: 'VERSION',
            description: '<Conditionally-Required> Restrict indexing to a single release version, e.g. 3.8.0. Leave empty to index all active releases. Required when DECISION is set, since a decision applies to one release.',
            defaultValue: '',
            trim: true
        )
        activeChoice(
            name: 'CRITERIA',
            choiceType: 'PT_CHECKBOX',
            description: '<Optional> Restrict indexing to the checked criteria. Check "all" to index every criterion.',
            filterable: false,
            randomName: 'choice-parameter-release-state-criteria',
            script: groovyScript(
                fallbackScript: [classpath: [], oldScript: '', sandbox: true, script: 'return ["Unknown criteria"]'],
                script: [classpath: [], oldScript: '', sandbox: true, script: '''return [
                    "all",
                    "release_owners_assigned",
                    "documentation_draft_prs_up",
                    "code_coverage_not_decreased",
                    "release_notes_ready",
                    "release_ticket_and_forum_post",
                    "documentation_reviewed_signed_off",
                    "all_integration_tests_passing",
                    "no_unpatched_vulnerabilities",
                    "sanity_testing_done",
                    "roadmap_up_to_date",
                    "security_reviews_complete",
                    "performance_tests_posted",
                    "release_blog_ready"
                ]'''])
        )
        choice(
            name: 'DECISION',
            description: '<Optional> Record a release manager Go/No-Go decision for VERSION. Leave as none to only index state.',
            choices: ['none', 'go', 'no-go', 'hold']
        )
        string(
            name: 'DECIDED_BY_SLACK_USER',
            description: '<Conditionally-Required> Do not fill this in by hand. Injected by OSCAR from the authenticated Slack identity of whoever asked for the decision. Every trigger of this job shares one Jenkins token, so this is the only identity that attributes a decision to a person; the decision stage fails without it when DECISION is set.',
            defaultValue: '',
            trim: true
        )
        string(
            name: 'DECIDED_BY_DISPLAY_NAME',
            description: '<Optional> Do not fill this in by hand. Injected by OSCAR from the authenticated Slack profile of whoever asked for the decision, so the release issue can name a person rather than an opaque id.',
            defaultValue: '',
            trim: true
        )
        choice(
            name: 'OSCAR_RECOMMENDATION',
            description: "<Optional> OSCAR's verdict at decision time, recorded so the decision can later be compared against the recommendation. Must be the verdict get_release_status returned in this conversation - leave as none rather than guessing one.",
            choices: ['none', 'red', 'yellow', 'green']
        )
        text(
            name: 'DECISION_NOTES',
            description: '<Optional> Rationale for the decision, e.g. why a criterion was waived.',
            defaultValue: ''
        )
    }
    stages {
        stage('Index Release State') {
            steps {
                script {
                    def indexArgs = [:]
                    if (params.VERSION?.trim()) {
                        indexArgs.version = params.VERSION.trim()
                    }
                    List selected = params.CRITERIA ? params.CRITERIA.tokenize(',') : []
                    List criteria = []
                    for (entry in selected) {
                        String name = entry.trim()
                        if (name && name != 'all') {
                            criteria.add(name)
                        }
                    }
                    if (criteria) {
                        indexArgs.criteria = criteria.join(',')
                    }
                    def indexedReleases = indexReleaseState(indexArgs)
                    writeJSON file: 'indexed-releases.json', json: indexedReleases
                    stash includes: 'indexed-releases.json', name: "indexed-releases-${env.BUILD_NUMBER}"
                }
            }
        }
        stage('Update Release Issues') {
            steps {
                script {
                    unstash "indexed-releases-${env.BUILD_NUMBER}"
                    def indexedReleases = readJSON file: 'indexed-releases.json'
                    for (release in indexedReleases) {
                        if (release.releaseIssue) {
                            updateReleaseIssue(version: release.version, releaseIssue: release.releaseIssue, action: 'update_criteria')
                        } else {
                            echo("No release issue for version ${release.version}; skipping issue update.")
                        }
                    }
                }
            }
        }
        // A decision is recorded against one named version, so it runs only when the operator asked
        // for one. It follows the indexing stages so the snapshot it captures is the state the
        // decision was actually taken against, not whatever was last indexed six hours ago.
        stage('Record Release Decision') {
            when {
                beforeAgent true
                expression { params.DECISION?.trim() && params.DECISION.trim() != 'none' }
            }
            steps {
                script {
                    if (!params.VERSION?.trim()) {
                        error('VERSION is required when recording a decision; a decision applies to one release.')
                    }
                    String decidedBy = params.DECIDED_BY_SLACK_USER?.trim()
                    if (!decidedBy) {
                        error('DECIDED_BY_SLACK_USER is empty. A decision is only recordable through OSCAR, which injects the authenticated Slack identity of whoever asked for it.')
                    }
                    String recommendation = params.OSCAR_RECOMMENDATION?.trim()
                    recordReleaseDecision(
                        version: params.VERSION.trim(),
                        decision: params.DECISION.trim(),
                        decidedBy: decidedBy,
                        decidedByDisplayName: params.DECIDED_BY_DISPLAY_NAME?.trim() ?: null,
                        oscarRecommendation: (recommendation && recommendation != 'none') ? recommendation : null,
                        notes: params.DECISION_NOTES?.trim() ?: null
                    )
                }
            }
        }
    }
    post {
        always {
            script {
                postCleanup()
            }
        }
    }
}
