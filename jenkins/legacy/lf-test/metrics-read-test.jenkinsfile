// @job-name: lf-metrics-read-test
// @description: Read-only connectivity check against the LF metrics cluster. Searches the
// opensearch_release_schedule index for a version and fails on any error or missing doc.

lib = library(identifier: 'jenkins@lf-jenkins', retriever: modernSCM([
    $class: 'GitSCMSource',
    remote: 'https://github.com/opensearch-project/opensearch-build-libraries.git',
]))

pipeline {
    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(daysToKeepStr: '30'))
    }
    agent {
        docker {
            label 'Jenkins-Agent-AL2023-X64-M54xlarge-Docker-Host'
            image 'opensearchorg/opensearchstaging/ci-runner:ci-runner-almalinux8-opensearch-build-v1'
            registryUrl 'https://public.ecr.aws/'
            alwaysPull true
        }
    }
    parameters {
        string(
            name: 'VERSION',
            description: 'Release version to read from opensearch_release_schedule.',
            defaultValue: '3.10.0',
            trim: true
        )
    }
    stages {
        stage('Metrics read check') {
            steps {
                script {
                    withSecrets(secrets: [
                        [envVar: 'METRICS_HOST_ACCOUNT', secretRef: 'op://opensearch-release-secrets/aws-accounts/opensearch-project-managed-aws-account-lf'],
                        [envVar: 'METRICS_HOST_URL', secretRef: 'op://opensearch-release-secrets/metrics-cluster/jenkins-health-metrics-cluster-endpoint-lf']
                    ]) {
                        withAWS(role: 'opensearch-metrics', roleAccount: "${METRICS_HOST_ACCOUNT}", duration: 900, roleSessionName: 'jenkins-session') {
                            def query = lib.utils.OpenSearchMetricsQuery.new(env.METRICS_HOST_URL, env.AWS_ACCESS_KEY_ID,
                                env.AWS_SECRET_ACCESS_KEY, env.AWS_SESSION_TOKEN, this)
                            def resp = query.fetchMetricsFromIndex('opensearch_release_schedule',
                                "{\\\"query\\\":{\\\"match_phrase\\\":{\\\"version\\\":\\\"${params.VERSION}\\\"}}}")

                            // fetchMetrics does not check HTTP status, so fail explicitly on error JSON
                            if (resp?.error) {
                                error("Read failed: ${resp.error}")
                            }
                            def docs = (resp?.hits?.hits ?: []).collect { it._source }.findAll { it.version == params.VERSION }
                            if (!docs) {
                                error("Read OK but no schedule doc found for ${params.VERSION}")
                            }
                            docs.each { d ->
                                echo("""Read OK for ${d.version}:
  rc_date:                   ${d.rc_date}
  release_date:              ${d.release_date}
  release_issue:             ${d.release_issue}
  release_manager:           ${d.release_manager}
  release_manager_gh_handle: ${d.release_manager_gh_handle}
  status:                    ${d.status}
  registered_at:             ${d.registered_at}
  registered_by:             ${d.registered_by}""")
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                postCleanup()
            }
        }
    }
}
